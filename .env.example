# ---------- Firebase Web App (valores públicos de Firebase Console) ----------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# ID opcional de Google Analytics 4. Sin este valor no se cargan scripts de medición.
VITE_GA_MEASUREMENT_ID=
# URL pública del sitio, sin barra final (canonical, sitemap, Open Graph)
VITE_SITE_URL=http://localhost:5173
# Dominio opcional del correo administrativo. Permite ingresar con "admin".
VITE_ADMIN_EMAIL_DOMAIN=
