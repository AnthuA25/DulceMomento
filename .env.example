# ---------- FRONTEND (públicas: se incluyen en el bundle) ----------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# URL pública del sitio, sin barra final (canonical, sitemap, Open Graph)
VITE_SITE_URL=http://localhost:5173
# Dominio del correo de los administradores. Permite ingresar con "admin"
# en vez de "admin@tu-dominio.com". No es un secreto.
VITE_ADMIN_EMAIL_DOMAIN=
# Credenciales locales del modo demo sin Supabase. Si se dejan vacías,
# el proyecto usa admin / 2026USMP en modo de demostración.
VITE_ADMIN_USER=admin
VITE_ADMIN_PASSWORD=2026USMP

# ---------- SOLO PARA SCRIPTS LOCALES (nunca con prefijo VITE_) ----------
# Usadas únicamente por `npm run admin:create`. No subir a ningún repositorio.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- SECRETS DE EDGE FUNCTIONS ----------
# Se configuran con `supabase secrets set NOMBRE=valor`, no en este archivo:
#   RESEND_API_KEY          API key del proveedor de email (Resend)
#   EMAIL_FROM              Remitente verificado, p. ej. pedidos@tu-dominio.com
#   RESEND_WEBHOOK_SECRET   Secreto de firma del webhook de Resend (whsec_...)
#   CRON_SECRET             Cadena aleatoria para proteger run-automations
#   SITE_URL                URL pública del sitio (enlaces de los correos)
