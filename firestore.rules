rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validEmail(email) {
      return email is string && email.size() <= 254 && email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if isAdmin();
      allow write: if false;
    }

    match /customerProfiles/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'first_name', 'last_name', 'phone', 'email', 'created_at'])
        && request.resource.data.uid == uid
        && validEmail(request.resource.data.email)
        && request.resource.data.first_name is string
        && request.resource.data.last_name is string
        && request.resource.data.phone is string;
      allow delete: if false;
    }

    match /siteSettings/{key} {
      allow read: if isAdmin() || resource.data.is_public == true;
      allow write: if isAdmin();
    }

    match /contacts/{contactId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly([
          'first_name', 'last_name', 'email', 'phone', 'customer_type', 'lifecycle_stage',
          'crm_stage', 'marketing_consent', 'marketing_consent_at', 'source', 'created_at', 'updated_at'
        ])
        && request.resource.data.first_name is string
        && request.resource.data.first_name.size() >= 2
        && request.resource.data.first_name.size() <= 80
        && request.resource.data.last_name is string
        && request.resource.data.last_name.size() >= 2
        && request.resource.data.last_name.size() <= 80
        && validEmail(request.resource.data.email)
        && request.resource.data.phone is string
        && request.resource.data.marketing_consent is bool
        && request.resource.data.customer_type == 'nuevo'
        && request.resource.data.lifecycle_stage == 'lead'
        && request.resource.data.crm_stage == 'nuevo'
        && request.resource.data.source in ['formulario', 'chatbot', 'checkout', 'suscripcion'];
      allow update, delete: if isAdmin();
    }

    match /inquiries/{inquiryId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly([
          'contact_id', 'request_code', 'inquiry_type', 'product_name', 'event_type', 'event_date',
          'quantity', 'message', 'source', 'status', 'created_at'
        ])
        && request.resource.data.contact_id is string
        && request.resource.data.request_code is string
        && request.resource.data.inquiry_type in ['cotizacion', 'keke_personalizado', 'pedido', 'delivery', 'otro']
        && request.resource.data.source in ['formulario', 'chatbot', 'checkout', 'suscripcion']
        && request.resource.data.status == 'nueva';
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.customer_uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.customer_uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'order_code', 'customer_uid', 'contact_id', 'contact', 'delivery_type', 'district', 'address',
          'reference', 'requested_date', 'comments', 'subtotal', 'delivery_fee', 'total', 'status',
          'payment_status', 'requires_price_verification', 'items', 'order_items', 'payments', 'created_at'
        ])
        && request.resource.data.status == 'recibido'
        && request.resource.data.payment_status == 'pendiente'
        && request.resource.data.requires_price_verification == true
        && request.resource.data.order_code is string
        && request.resource.data.contact.email == request.auth.token.email
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 20
        && request.resource.data.order_items is list
        && request.resource.data.payments is list
        && request.resource.data.payments.size() == 1;
      allow update, delete: if isAdmin();
    }

    match /crmNotes/{noteId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
